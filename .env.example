MONITOR_HOST=127.0.0.1
MONITOR_PORT=8000
HCAPTCHA_ROOT=/www/wwwroot/hcaptcha
HCAPTCHA_SERVICE_URL=http://127.0.0.1:43333
HCAPTCHA_ADMIN_SECRET=use-the-same-value-as-the-hcaptcha-service
MONITOR_DATABASE=./data/monitor.db
MONITOR_SYNC_INTERVAL_SECONDS=2
MONITOR_RETENTION_DAYS=1
# Resident memory ceiling. On crossing it the process logs and exits so the
# supervisor restarts this program alone; letting the kernel OOM killer act
# instead fails the whole supervisor unit and takes unrelated services with it.
MONITOR_MEMORY_LIMIT_MB=1024
HCAPTCHA_PROBE_TIMEOUT_SECONDS=1
MONITOR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
